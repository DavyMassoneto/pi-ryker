{
  "name": "pi-ryker",
  "version": "0.1.0",
  "description": "Ryker: etapa de Discussão Global para o pi",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DavyMassoneto/pi-ryker.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^22",
    "typebox": "1.3.27",
    "typescript": "^5.9"
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "check": "npm run lint && npm run typecheck && npm test"
  }
}
